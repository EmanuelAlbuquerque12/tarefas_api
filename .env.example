# Configurações da API ProJuris
# Copie este arquivo para .env e preencha com suas credenciais

PROJURIS_DOMAIN=seu_dominio
PROJURIS_USER=seu_usuario@dominio.adv.br
PROJURIS_PASSWORD=sua_senha
PROJURIS_API_URL=https://api.projurisadv.com.br/adv-service
PROJURIS_TOKEN_URL=https://apigw.projurisadv.com.br/auth/token
PROJURIS_CLIENT_ID=seu_client_id
PROJURIS_CLIENT_SECRET=seu_client_secret

# Configurações do servidor local
PORT=3000
NODE_ENV=development
